# Server
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/garage-management-system

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS: comma-separated allowed origins (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Cloudinary (photo uploads — inspection photos, service category photos).
# Get these from the Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (real email for "send to customer" actions — quotes, additional
# service proposals, invoices). If left blank, sending is skipped with a
# console warning; nothing else breaks.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address,
# SMTP_PASS=a 16-character App Password (not your normal password) —
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
